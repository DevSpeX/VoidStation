DISK_TYPES = ("disk", "loop") if TEST else ("disk",)


class Fail(Exception):
    """Fehler mit Kennung fuer die Oberflaeche (Text dazu steht in web/i18n)."""
    def __init__(self, code, msg=""):
        super().__init__(msg or code)
        self.code, self.msg = code, msg or code


# ---------------------------------------------------------------------------
#  Grundfunktionen
# ---------------------------------------------------------------------------
SECRETS = []                                          # Passwoerter: nie ins Protokoll


def log(*a):
    RUNDIR.mkdir(parents=True, exist_ok=True)
    line = " ".join(str(x) for x in a)
    for sec in SECRETS:
        line = line.replace("=" + sec, "=***")           # steht nur als SMBPASS=… in Befehlszeilen
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(time.strftime("%H:%M:%S ") + line + "\n")


def emit(**ev):
    print(json.dumps(ev, ensure_ascii=False), flush=True)
    if ev.get("ev") != "progress":
        log("EVENT", json.dumps(ev, ensure_ascii=False))


def sh(cmd, check=True, input=None, env=None, quiet=False, timeout=None):
    """Befehl ausfuehren, alles ins Protokoll. Gibt CompletedProcess zurueck."""
    log("$", " ".join(cmd) if isinstance(cmd, list) else cmd)
    try:
        r = subprocess.run(cmd, input=input, capture_output=True, text=True, env=env, timeout=timeout,
                           shell=isinstance(cmd, str))
    except FileNotFoundError:
        r = subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: Befehl fehlt")
    except subprocess.TimeoutExpired:
        r = subprocess.CompletedProcess(cmd, 124, "", "Zeitueberschreitung")
    out = (r.stdout + r.stderr).strip()
    if out and not quiet:
        log(out[-4000:])
    if check and r.returncode != 0:
        raise Fail("command", f"{cmd if isinstance(cmd, str) else ' '.join(cmd)}: {out[-400:] or r.returncode}")
    return r


def chroot(cmd, check=True, input=None):
    return sh(["chroot", str(TARGET)] + (cmd if isinstance(cmd, list) else ["/bin/sh", "-c", cmd]),
              check=check, input=input, env={"PATH": "/usr/bin:/usr/sbin:/bin:/sbin", "LANG": "C"})


def mounted(path):
    return os.path.ismount(str(path))


def read_json_state():
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def save_state(st):
    RUNDIR.mkdir(parents=True, exist_ok=True)
    os.chmod(RUNDIR, 0o700)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, ensure_ascii=False), encoding="utf-8")
    os.chmod(tmp, 0o600)
    tmp.replace(STATE)


def settle():
    sh(["udevadm", "settle", "--timeout=10"], check=False, quiet=True)
    time.sleep(0.5)


def part_path(disk, num):
    return f"{disk}p{num}" if re.search(r"\d$", disk) else f"{disk}{num}"


def blkid(dev, tag):
    r = sh(["blkid", "-s", tag, "-o", "value", dev], check=False, quiet=True)
    return r.stdout.strip()


def align_up(v, a):
    return (v + a - 1) // a * a


