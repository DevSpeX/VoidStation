"""
VoidStation-Installer (root) – nur im Live-System vorhanden.

Die Oberflaeche (launcher.py) ruft dieses Skript per sudo auf; die ganze Logik steckt hier,
damit Kachel-Oberflaeche und Terminal (voidstation-installer text) dasselbe tun.

  probe                     Geraet pruefen: UEFI, RAM, Platten, Partitionen, fremde Systeme, moegliche Wege (JSON)
  run                       installieren; Einstellungen als JSON auf stdin, Fortschritt als JSON-Zeilen auf stdout
  run --resume [--alt]      nach einem Fehler ab dem fehlgeschlagenen Schritt weitermachen (--alt: Ausweichweg)
  gparted DISPLAY XAUTH     GParted als root auf dem Bildschirm oeffnen
  savelog                   Protokoll auf einen eingesteckten USB-Stick kopieren
  text                      Installation im Terminal (Rueckfall, nur "ganze SSD")

Schritte von "run":  check → shrink → partition → format → copy → configure → boot → cleanup
Jeder Schritt ist wiederholbar; der Stand liegt in /run/voidstation-installer/state.json (nur root).
"""
import getpass
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

RUNDIR = Path("/run/voidstation-installer")
STATE = RUNDIR / "state.json"
LOG = RUNDIR / "install.log"
TARGET = Path("/mnt/voidstation")
BASEMNT = RUNDIR / "base"
PROBEMNT = RUNDIR / "probe"
LIVE_MARK = Path("/etc/voidstation-live")
MiB = 1024 ** 2
GiB = 1024 ** 3
MIN_ROOT = 16 * GiB
ESP_SIZE = 512 * MiB
HEADROOM = 2 * GiB                                    # Platz, der dem fremden System mindestens frei bleibt
PHASES = ["check", "shrink", "partition", "format", "copy", "configure", "boot", "cleanup"]
WEIGHT = {"check": 2, "shrink": 8, "partition": 2, "format": 3, "copy": 60, "configure": 15, "boot": 7, "cleanup": 3}

GUID = {
    "esp": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b", "linux": "0fc63daf-8483-4772-8e79-3d69d8477de4",
    "msdata": "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7", "msres": "e3c9e316-0b5c-4db8-817d-f92df00215ae",
    "winre": "de94bba4-06d1-4d40-a16a-bfd50179d6ac", "swap": "0657fd6d-a4ab-43c4-84e5-0933c84b4f4f",
    "fbsd_ufs": "516e7cb6-6ecf-11d6-8ff8-00022d09712b", "fbsd_zfs": "516e7cba-6ecf-11d6-8ff8-00022d09712b",
    "fbsd_boot": "83bd6b9d-7f41-11dc-be0b-001560b84f0f", "fbsd_swap": "516e7cb5-6ecf-11d6-8ff8-00022d09712b",
    "openbsd": "824cc7a0-36a8-11e3-890a-952519ad3f61", "netbsd": "49f48d5a-b10e-11dc-b99b-0019d1879648",
}
