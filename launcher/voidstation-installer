def cmd_gparted(args):
    if len(args) < 2 or not re.fullmatch(r":\d+(\.\d+)?", args[0]) or not re.fullmatch(r"/[\w./-]+", args[1]):
        print("gparted DISPLAY XAUTHORITY"); return 2
    if not LIVE_MARK.exists():
        return 2
    env = {"PATH": "/usr/bin:/usr/sbin:/bin:/sbin", "DISPLAY": args[0], "XAUTHORITY": args[1], "HOME": "/root"}
    subprocess.Popen(["gparted"], env=env, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(json.dumps({"ok": True}))
    return 0


def cmd_savelog(_args):
    """Protokoll auf den ersten beschreibbaren USB-Datentraeger (FAT/exFAT/NTFS) kopieren."""
    lsb = json.loads(sh(["lsblk", "-J", "-p", "-o", "NAME,TRAN,RM,FSTYPE,MOUNTPOINT,TYPE"], quiet=True).stdout)
    name = f"voidstation-install-{time.strftime('%Y%m%d-%H%M')}.log"
    for d in lsb.get("blockdevices", []):
        if d.get("tran") != "usb" and not d.get("rm"):
            continue
        for p in [d] + (d.get("children") or []):
            if p.get("fstype") not in ("vfat", "exfat", "ntfs"):
                continue
            mp, own = p.get("mountpoint"), False
            if not mp:
                mnt = RUNDIR / "usb"
                mnt.mkdir(parents=True, exist_ok=True)
                if sh(["mount", "-o", "rw", p["name"], str(mnt)], check=False).returncode != 0:
                    continue
                mp, own = str(mnt), True
            try:
                shutil.copy2(LOG, Path(mp) / name)
                sh(["sync"], check=False)
                print(json.dumps({"ok": True, "device": p["name"], "file": name}))
                return 0
            except OSError:
                pass
            finally:
                if own:
                    sh(["umount", mp], check=False)
    print(json.dumps({"ok": False, "code": "no_usb"}))
    return 1


def cmd_text(_args):
    """Rueckfall im Terminal: ganze SSD, wenige Fragen."""
    p = probe()
    if not p["uefi"]:
        print("Nicht im UEFI-Modus gestartet – im Firmware-Setup UEFI einschalten (CSM/Legacy aus)."); return 1
    disks = [d for d in p["disks"] if d["options"].get("whole")]
    if not disks:
        print("Keine passende interne SSD gefunden (mind. 17 GB)."); return 1
    for i, d in enumerate(disks, 1):
        print(f"  {i}) {d['path']}  {d['size'] // 10**9} GB  {d['model']}  {', '.join(d['systems'])}")
    n = int(input("Nummer der Ziel-SSD (wird KOMPLETT geloescht): ") or "1")
    disk = disks[n - 1]["path"]
    name = input("Name [Paul]: ").strip() or "Paul"
    login = re.sub(r"[^a-z0-9_-]", "", name.lower().replace("ä", "ae").replace("ö", "oe").replace("ü", "ue").replace("ß", "ss")) or "user"
    while True:
        pw = getpass.getpass("Passwort: ")
        if pw and pw == getpass.getpass("Nochmal: "):
            break
        print("Leer oder nicht gleich.")
    host = input("Rechnername [tv]: ").strip() or "tv"
    if input(f"ALLE Daten auf {disk} loeschen? JA eintippen: ") != "JA":
        print("Abgebrochen."); return 1
    cfg = {"mode": "whole", "disk": disk, "user": {"name": name, "login": login, "password": pw}, "hostname": host,
           "lang": "de", "keymap": "de", "timezone": "Europe/Berlin", "channel": "stable", "wifi": True, "share": True,
           "favorites": True, "rtc_local": False}
    bad = validate(cfg)
    if bad:
        print("Ungueltige Angabe:", bad); return 1
    RUNDIR.mkdir(parents=True, exist_ok=True)
    st = {"config": cfg, "done": [], "started": time.time()}
    save_state(st)
    return Run(st).run()


def main(argv):
    if os.geteuid() != 0:
        print("nur als root"); return 2
    cmd, args = (argv[1] if len(argv) > 1 else ""), argv[2:]
    if cmd == "probe":
        print(json.dumps(probe(), ensure_ascii=False)); return 0
    if cmd == "run":
        return cmd_run(args)
    if cmd == "gparted":
        return cmd_gparted(args)
    if cmd == "savelog":
        return cmd_savelog(args)
    if cmd == "log":
        try:
            print(LOG.read_text(encoding="utf-8")[-20000:])
        except OSError:
            pass
        return 0
    if cmd == "text":
        return cmd_text(args)
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
